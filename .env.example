# Copy to .env.local and fill in. Without these, Beacon runs on built-in demo data
# stored in the browser (localStorage), so the app works before Supabase is set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The iMessage handle or phone number your Photon 2.0 agent answers on,
# e.g. +14695551234 or beau@yourdomain.com. Used by the "Message Beau" button.
NEXT_PUBLIC_BEAU_IMESSAGE=
