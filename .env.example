# Copy to .env.local and fill in. Without these, Beacon runs on built-in demo data
# stored in the browser (localStorage), so the app works before Supabase is set up.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The iMessage handle or phone number your Photon 2.0 agent answers on,
# e.g. +14695551234 or beau@yourdomain.com. Used by the "Message Beau" button.
NEXT_PUBLIC_BEAU_IMESSAGE=

# ---------------------------------------------------------------------------
# Beau (agent/) — server-only. Never prefix these with NEXT_PUBLIC_.
# The agent reads this same .env.local file.
# ---------------------------------------------------------------------------
# Supabase → Project Settings → API → service_role. Lets Beau read/write the
# subscribers table (phone numbers), which the public key can't see.
SUPABASE_SERVICE_ROLE_KEY=

# Beau's brain: set ONE of these. Without either, Beau uses a rule-based fallback.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Photon Spectrum (app.photon.codes → Get started → Add your credentials). Run: npm run imessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Photon 2.0 beta API (app.beta.photon.codes). Run: npm run imessage:beta
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
