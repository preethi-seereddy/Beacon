# Copy to .env and fill in. .env is gitignored.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (Beau's iMessage bridge). NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# NVIDIA Nemotron (build.nvidia.com -> API key)
# Server-side only. Do NOT prefix with VITE_ or it ships to the browser.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Photon Spectrum (app.photon.codes -> Get started -> Add your credentials)
# Run with: npm run imessage
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Photon 2.0 beta API (app.beta.photon.codes -> Settings -> Project ID; API keys -> project:read + project:write)
# Run with: npm run imessage:beta
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
